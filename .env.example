# =====================================================
# あんたがおらな Vercel環境変数テンプレート
# このファイルをコピーして .env.local を作成し、
# 実際の値を入力してください。
# .env.local は .gitignore に入れてコミットしないこと。
# 本番用の値は Vercel Dashboard > Settings > Environment Variables で設定する。
# =====================================================

# ── Stripe ──────────────────────────────────────────
# 本番: sk_live_... / テスト: sk_test_...
# Vercel Dashboard で設定すること。このファイルには実際のキーを記載しない。
STRIPE_SECRET_KEY=<YOUR_STRIPE_SECRET_KEY>

# Stripe Dashboard > Webhooks > エンドポイント > Signing Secret
STRIPE_WEBHOOK_SECRET=<YOUR_STRIPE_WEBHOOK_SECRET>

# ── Resend（メール送信） ────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=<YOUR_RESEND_API_KEY>

# 送信元メールアドレス（Resendで送信ドメイン設定済みのもの）
FROM_EMAIL=info@antagaorana.com

# ── 共育ゼミ 開催回設定 ──────────────────────────────
# 開催ごとにこの3項目を更新する（Vercel Dashboardから変更可能）
SESSION_DATE=2026年8月30日（日）
SESSION_TIME_START=20:00
SESSION_TIME_END=21:30

# Google MeetのURL（絶対にフロントエンドのHTMLやJSに書かない）
SESSION_MEET_URL=https://meet.google.com/xxx-xxxx-xxx

# ── Supabase（申込・メール送信状態の永続化） ─────────
# https://supabase.com/dashboard > Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role secret key（絶対にフロントへ出さない）
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>

# ── テストモード ────────────────────────────────────
# 'true' にするとテスト決済でもメールを送信しない（ログのみ）
# 本番では必ず 'false' または削除すること
TEST_MODE=true

# ── HAKU Community（テスト環境専用） ─────────────────
# api/haku-checkout.js が使う、HAKU Community 月額プランの Stripe Price ID
# Stripe Dashboard（テストモード）> 商品 で作成した価格のID
STRIPE_PRICE_ID=<YOUR_HAKU_STRIPE_PRICE_ID>

# api/haku-stripe-webhook.js 専用の Signing Secret（共育ゼミの STRIPE_WEBHOOK_SECRET とは別物）
# Stripe Dashboard > Webhooks > このエンドポイント用に新規追加 > Signing Secret
# 【Preview】必須（checkout.session.completed / invoice.payment_failed /
#   customer.subscription.updated / customer.subscription.deleted を購読するエンドポイント）
# 【Production】HAKU Community を本番公開する際、本番用Webhookエンドポイントの
#   Signing Secretに差し替える（テストモードの値を流用しないこと）
HAKU_STRIPE_WEBHOOK_SECRET=<YOUR_HAKU_STRIPE_WEBHOOK_SECRET>

# ── HAKU Community / 教育者のサロン 灯：会員基盤の永続化先（Redis） ─────
# api/_lib/store.redis.js が使う、Upstash Redis（または互換Redis）の接続文字列。
# 【Preview】必須。これが無いと登録・ログイン・承認・決済連携・ことば投稿・
#   イベント等、HAKU Community / 灯 の会員機能全体が動作しない（getRedis()が例外を投げる）。
# 【Production】DB_BACKEND=postgres へ切り替えた後も、Session・パスワード設定/再設定
#   トークン・レート制限・Stripe顧客ID索引・Webhook idempotency ledgerは引き続き
#   Redis側のみを使うため、本番でも別途Redisインスタンスが必要（永続データはPostgres側）。
REDIS_URL=<YOUR_REDIS_CONNECTION_STRING>

# ── 管理画面（/admin-community.html）── ─────────────
# 個別管理者アカウントが1件も無い間だけ使える、初回セットアップ用の共有パスワード。
# 【Preview】任意（無くても個別アカウントさえ作成済みなら動作する。未設定でも
#   エラーにはならないが、bootstrap-adminによる最初の管理者アカウント作成ができなくなる）
# 【Production】本番投入前に、本番用の値へ入れ替えるか、個別管理者アカウントを
#   作成済みにした上でこの変数自体を削除することを推奨（恒久的な共有パスワードを
#   本番に残さないため）
HT_ADMIN_PASSWORD=<YOUR_ADMIN_BOOTSTRAP_PASSWORD>

# 新規申込・管理者向け通知メールの宛先（カンマ区切り、複数可）。既存の共育ゼミの
# 申込通知にも共用される変数。
# 【Preview】任意（未設定時はFROM_EMAIL宛にフォールバックする）
# 【Production】必須（運営が実際に確認するメールアドレスを設定すること）
ADMIN_EMAILS=<YOUR_ADMIN_NOTIFICATION_EMAILS>

# ── DBバックエンド切り替え（本番移行用。Preview では未設定＝Redisのまま） ──
# 'postgres' を設定すると、User/Application/Membership/AdminUser/AuditLog が
# store.pg.js（Supabase Postgres）経由になる（未設定またはそれ以外の値は
# 常にstore.redis.js＝Upstash Redisを使う、現在のPreviewのデフォルト挙動）。
# CommunityPost・Event・行動目標/マイセッションフィクスチャ・EmailLog・Session・
# 各種トークン・レート制限・Webhook idempotency ledgerはこの値に関わらず常にRedis。
# 【Preview】未設定のままにする（Redisで動作確認する現行方針）
# 【Production】永続データをPostgresで管理する場合のみ 'postgres' を設定する
#   （supabase/schema.sql を先に適用し、HT_SUPABASE_URL/HT_SUPABASE_SERVICE_ROLE_KEY
#   を設定した後に切り替えること）
DB_BACKEND=<postgres_OR_unset_for_redis>

# HAKU Community / 灯 専用のSupabaseプロジェクト（既存の共育ゼミ用SUPABASE_URL /
# SUPABASE_SERVICE_ROLE_KEYとは別の、新規専用プロジェクトを前提とした変数名。
# api/_lib/store.pg.js が使用）。
# 【Preview】DB_BACKEND=postgresでPostgres経路を試す場合のみ設定する
# 【Production】DB_BACKEND=postgresへ移行する場合に必須
HT_SUPABASE_URL=<YOUR_HAKU_SUPABASE_PROJECT_URL>
HT_SUPABASE_SERVICE_ROLE_KEY=<YOUR_HAKU_SUPABASE_SERVICE_ROLE_KEY>
